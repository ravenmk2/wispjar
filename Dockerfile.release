# syntax=docker/dockerfile:1

# goreleaser release image: the binary is prebuilt by goreleaser (with the
# web/dist frontend embedded via go:embed), and the build context contains
# only this Dockerfile and the binaries under linux/<arch>/.
# For building images from source (local/server builds), use the multi-stage
# Dockerfile at the repository root instead.
FROM alpine:3
RUN apk add --no-cache ca-certificates
ARG TARGETPLATFORM
COPY ${TARGETPLATFORM}/wispjar /usr/local/bin/wispjar
ENTRYPOINT ["wispjar"]
